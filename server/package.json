{
  "name": "kobo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend MERN de Kobo (Express + Mongoose + JWT + zod)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "bash -c 'shopt -s globstar; node --import tsx --test src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "smoke:ingest": "tsx scripts/smoke-ingest.ts",
    "smoke:push": "tsx scripts/smoke-push.ts",
    "smoke:funds": "tsx scripts/smoke-funds.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

# Kobo backend — variables para desarrollo local (`npm run dev`).
# En producción las inyecta docker-compose desde el .env de la raíz.
NODE_ENV=development
PORT=4100

# MongoDB local aparte: el mongo del compose NO publica puerto (ver docker-compose.yml).
MONGODB_URI=mongodb://kobo:CHANGEME@127.0.0.1:27017/kobo?authSource=admin

# JWT (mínimo 16 caracteres). El backend hace process.exit(1) si faltan.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Origen del cliente para CORS (Vite en dev).
CLIENT_ORIGIN=http://localhost:5173

# ----- Seed (`npm run seed`) -----
# Datos personales: NUNCA se hardcodean en el repo. Sin valores por defecto:
# si faltan, el seed aborta en vez de crear un usuario con credenciales conocidas.
SEED_EMAIL=
SEED_PASSWORD=            # mínimo 8 caracteres
SEED_NOMINA_CENTS=        # entero en céntimos (p. ej. 200000 = 2.000,00 €)

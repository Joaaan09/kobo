# =====================================================================
# Kobo — Variables para docker-compose (PRODUCCIÓN)
# =====================================================================
# Copia este archivo a `.env` EN EL SERVIDOR y rellena los valores.
# El `.env` real NUNCA se commitea (está en .gitignore).
#
# Genera secretos seguros con:
#   openssl rand -base64 32

# ----- MongoDB (credenciales del contenedor mongo:7) -----
MONGO_USER=kobo
MONGO_PASSWORD=

# ----- JWT (OBLIGATORIOS, mínimo 16 caracteres) -----
# El backend hace process.exit(1) al arrancar si faltan.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ----- Origen del cliente (para CORS) -----
# Dominio público servido por Nginx Proxy Manager (p. ej. https://kobo.tudominio.com).
CLIENT_ORIGIN=

# ----- URL de la API (build-arg del frontend) -----
# Relativa: mismo origen. El nginx del frontend proxya /api al backend.
# Normalmente NO hace falta cambiarla.
VITE_API_URL=/api

# ----- Notificaciones push (Web Push / VAPID) -----
# OPCIONALES: si faltan, Kobo arranca igual y las push quedan desactivadas
# (la UI de Ajustes lo dice en vez de fallar).
# Genera el par con:  npx web-push generate-vapid-keys
# La PÚBLICA no es secreta (va al navegador). La PRIVADA sí: trátala como el JWT.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el estándar; sirve al proveedor de push para avisarte de problemas.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
